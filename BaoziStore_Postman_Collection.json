      "name": "01 Clientes",
      "item": [
        {
          "name": "POST Criar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeClienteRU}}\",\n  \"clienteDesde\": \"2026-11-17\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"clienteId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
